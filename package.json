  "homepage": "https://github.com/lora-sys/teaching-html-story-deck#readme",
  "bugs": {
    "url": "https://github.com/lora-sys/teaching-html-story-deck/issues"
  },
  "keywords": [
    "agent-skill",
    "teaching",
    "html",
    "storytelling",
    "svg",
    "presentation",
    "interactive",
    "claude-code",
    "cline",
    "codex",
    "opencode",
